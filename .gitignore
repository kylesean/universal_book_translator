# Python & virtualenv
__pycache__/
*.egg-info/
dist/
.venv/
.env*
ubt.toml


# Caches & tests
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/

# UBT state & output
.ubt/
.ubt_cache/
*.sqlite*
*.db*
# A stray `:memory:.ses` (a timestamp + UUID, written by some tool's session
# handling) was committed by accident from a repo-root shell and stayed tracked
# for three commits. Nothing reads it; the pattern keeps the next one out.
*.ses
output/
tmp/
scratch/
# Agent/tool scratch space. The name never matched ``scratch/``, so a
# pre-commit cache lock landed in a commit by accident; both spellings are
# ignored now so a local scratch directory can never be staged.
.scratch/
scripts/mathjax/node_modules/
web/node_modules/
node_modules/
web/dist/

# Docs: the working notes (benchmarks, reviews) change too often to track and
# stay unversioned, but `docs/guides/` is referenced as the authority by
# CONTRIBUTING.md, pyproject.toml, the pre-commit config and code comments —
# those links must resolve in a fresh clone, so the guides are versioned.
/docs/*
!/docs/README.md
!/docs/guides/

# Generated corpus & deliverables
tests/fixtures/*.pdf
/out*
/*_bilingual.*
/*_quality_report.*
/*_visual_report.*

# Editors & OS
.idea/
.vscode/
.DS_Store
.codex/
.claude/
.codegraph/
# Agent-tooling state (mimo/cron task runner). Untracked, and not useful to a
# clone; without this it shows up as untracked noise in every `git status`.
.mimocode/
