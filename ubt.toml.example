# UBT provider registry template. Copy to ubt.toml.
# Precedence: CLI flag > env (UBT_*) > [providers.<name>] > [defaults] > field default.
# Never put a secret here: a block carrying one is rejected. Put the variable name
# in api_key_env and the key in the environment (UBT_LLM_API_KEY outranks it).

# Built-ins need no block: openai / anthropic / gemini / deepseek / opencode.
#   export UBT_PROVIDER=anthropic
#   export UBT_LLM_API_KEY=sk-ant-...

# The four wire protocols: openai-chat | openai-responses | anthropic-messages |
# gemini-native. Every provider -- gateway, relay, local server -- speaks one of
# them, so api_mode is the only thing that selects the protocol. Never inferred
# from the host or the model name.

# A custom OpenAI-compatible endpoint:
# [providers.my-gateway]
# base_url = "https://llm.internal.example/v1"
# api_mode = "openai-chat"
# api_key_env = "MY_GATEWAY_API_KEY"
# draft_model = "qwen3-32b"
# repair_model = "qwen3-32b"
# api_timeout = 300.0
# extra_headers = { "x-tenant" = "${MY_TENANT}" }

# [defaults] applies to every run, including a bare UBTConfig.from_env().
# [defaults]
# api_timeout = 180.0
# draft_reasoning_effort = "low"
# repair_reasoning_effort = "high"
# chat_template_kwargs = { enable_thinking = false }
# prompt_caching_enabled = true
