# Universal Book Translator (UBT) - provider registry template.
#
# Copy to `ubt.toml` in the working directory (or ~/.config/ubt/config.toml, or
# ~/.ubt/config.toml) and edit. Precedence, highest first:
#
#   CLI flag > process env (UBT_*) > [providers.<name>] > [defaults] > field default
#
# A provider bundles where and how to call an LLM — endpoint, wire protocol and
# default models — and names the variable holding its credential (api_key_env).
#
# NEVER put a secret in this file: a key committed to a version-controlled TOML
# is a leaked key, and a block carrying one is rejected. The secret goes in the
# environment: UBT_LLM_API_KEY (generic, outranks a provider's api_key_env), or
# the variable named by api_key_env.

# ---- Built-in providers ------------------------------------------------------
# openai / anthropic / gemini / deepseek / opencode need no block at all:
#
#   export UBT_PROVIDER=anthropic
#   export UBT_LLM_API_KEY=sk-ant-...
#
# Add a block only to override a built-in default (e.g. a newer model tier):
#
# [providers.anthropic]
# draft_model = "claude-3-7-sonnet"
# repair_model = "claude-3-7-sonnet"

# ---- A custom OpenAI-compatible endpoint ------------------------------------
# base_url, api_mode and the models are the provider's own; api_key_env names
# the variable the credential is read from (it is NOT a UBTConfig field).
#
# [providers.my-gateway]
# base_url = "https://llm.internal.example/v1"
# api_mode = "chat"            # chat | responses | anthropic
# api_key_env = "MY_GATEWAY_API_KEY"
# draft_model = "qwen3-32b"
# repair_model = "qwen3-32b"
# api_timeout = 300.0

# ---- Shared, non-secret settings under every provider -----------------------
# [defaults] applies to EVERY run, including a bare UBTConfig.from_env(), so put
# only settings you truly want everywhere. Anything a provider sets overrides it.
#
# [defaults]
# api_timeout = 180.0
# draft_reasoning_effort = "low"
# repair_reasoning_effort = "high"
# chat_template_kwargs = { enable_thinking = false }
# prompt_caching_enabled = true
